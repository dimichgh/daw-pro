{
  "format": "dawpro.template",
  "formatVersion": 1,
  "minReaderVersion": 1,
  "id": "rock-band",
  "name": "Rock Band",
  "summary": "Two guitars panned left and right over grouped drums and a tight bass, with a room reverb for the lead parts.",
  "songForm": "rock",
  "genres": ["rock", "metal"],
  "tracks": [
    { "key": "drums", "name": "Drums", "kind": "instrument", "volume": 1.99, "output": "drum-bus",
      "instrument": { "kind": "soundBank", "soundBank": { "source": "gm", "program": 0, "bankMSB": 120, "bankLSB": 0 } },
      "sends": [ { "bus": "room", "level": 0.15 } ] },
    { "key": "bass", "name": "Bass", "kind": "instrument", "volume": 1.33, "mixerPreset": "bass-tight",
      "instrument": { "kind": "soundBank", "soundBank": { "source": "gm", "program": 33 } } },
    { "key": "rhythm-guitar", "name": "Rhythm Guitar", "kind": "instrument", "volume": 0.68, "pan": -0.6,
      "mixerPreset": "guitar-crunch",
      "instrument": { "kind": "soundBank", "soundBank": { "source": "gm", "program": 29 } } },
    { "key": "lead-guitar", "name": "Lead Guitar", "kind": "instrument", "volume": 0.87, "pan": 0.6,
      "mixerPreset": "guitar-crunch",
      "instrument": { "kind": "soundBank", "soundBank": { "source": "gm", "program": 30 } },
      "sends": [ { "bus": "room", "level": 0.25 } ] },
    { "key": "vocal", "name": "Lead Vocal", "kind": "audio", "mixerPreset": "vocal-presence",
      "sends": [ { "bus": "room", "level": 0.2 } ] },
    { "key": "drum-bus", "name": "Drum Bus", "kind": "bus", "mixerPreset": "drum-bus-glue" },
    { "key": "room", "name": "Room", "kind": "bus",
      "inserts": [ { "kind": "reverb", "params": { "mix": 1, "roomSize": 0.45 } } ] }
  ]
}
