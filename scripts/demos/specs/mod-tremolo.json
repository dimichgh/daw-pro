{
  "set": "mod-tremolo",
  "description": "Tremolo \u2014 a sine LFO on the volume fader at a fixed 5 Hz, ONE axis: how deep. Zero new effect code: this falls out of the modulation layer's per-sample .volume takeover, which is exactly why the creative-effects plan lists tremolo as documentation rather than a build. The LFO is BIPOLAR here (unlike the trance gate's unipolar square), so it swings the fader symmetrically about its resting value instead of only cutting. Depth follows the \u00a77.3 depth law, where 0.125 is about +/-6 dB on a volume target. EVERY VARIANT SITS AT FADER 0.6, CONTROL INCLUDED. A bipolar LFO swings the fader BOTH ways about its resting value, so at the default 1.0 the upward half has nowhere to go: the first render of this set clipped at +0.5 dBTP and would have reached the listener as distortion rather than tremolo. Leaving headroom is how the effect is actually used, and keeping the control at the same 0.6 keeps the comparison fair.",
  "variants": [
    {
      "name": "no-tremolo",
      "axis": "no modulation at all \u2014 the flat chord",
      "commands": [
        {
          "command": "track.add",
          "params": {
            "name": "Pad",
            "kind": "instrument"
          },
          "as": "pad"
        },
        {
          "command": "track.setInstrument",
          "params": {
            "trackId": "$pad",
            "kind": "polySynth",
            "waveform": "saw",
            "attack": 0.02,
            "decay": 0.3,
            "sustain": 0.9,
            "release": 0.4,
            "cutoffHz": 2200,
            "resonance": 0.12,
            "gain": 0.75,
            "unisonVoices": 6,
            "unisonDetuneCents": 14,
            "unisonStereoSpread": 0.7
          }
        },
        {
          "command": "track.setVolume",
          "params": {
            "trackId": "$pad",
            "volume": 0.6
          }
        },
        {
          "command": "clip.addMIDI",
          "params": {
            "trackId": "$pad",
            "atBeat": 0,
            "notes": [
              {
                "pitch": 48,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 55,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 60,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 64,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 67,
                "startBeat": 0,
                "lengthBeats": 8
              }
            ]
          }
        }
      ],
      "role": "control"
    },
