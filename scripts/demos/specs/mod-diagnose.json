        {
          "command": "mod.addRoute",
          "params": {
            "trackId": "$pad",
            "sourceId": "$gate",
            "target": "volume",
            "depth": -0.6
          }
        },
        {
          "command": "clip.addMIDI",
          "params": {
            "trackId": "$pad",
            "atBeat": 0,
            "notes": [
              {
                "pitch": 48,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 55,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 60,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 64,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 67,
                "startBeat": 0,
                "lengthBeats": 8
              }
            ]
          }
        }
      ]
    },
