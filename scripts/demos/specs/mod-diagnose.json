    {
      "name": "lane-vol05",
      "axis": "POSITIVE CONTROL \u2014 volume 0.5 plus an ordinary automation LANE ramping 1.0 to 0.0 across the clip. This exercises the same render-stage gain machinery modulation borrows, with no modulation involved. It MUST differ from control-vol05.",
      "commands": [
        {
          "command": "track.add",
          "params": {
            "name": "Pad",
            "kind": "instrument"
          },
          "as": "pad"
        },
        {
          "command": "track.setInstrument",
          "params": {
            "trackId": "$pad",
            "kind": "polySynth",
            "waveform": "saw",
            "attack": 0.02,
            "decay": 0.3,
            "sustain": 0.9,
            "release": 0.4,
            "cutoffHz": 2200,
            "resonance": 0.12,
            "gain": 0.75
          }
        },
        {
          "command": "track.setVolume",
          "params": {
            "trackId": "$pad",
            "volume": 0.5
          }
        },
        {
          "command": "automation.addLane",
          "params": {
            "trackId": "$pad",
            "target": "volume"
          },
          "as": "volLane"
        },
        {
          "command": "automation.setPoints",
          "params": {
            "trackId": "$pad",
            "laneId": "$volLane",
            "points": [
              {
                "beat": 0,
                "value": 1.0
              },
              {
                "beat": 8,
                "value": 0.0
              }
            ]
          }
        },
        {
          "command": "clip.addMIDI",
          "params": {
            "trackId": "$pad",
            "atBeat": 0,
            "notes": [
              {
                "pitch": 48,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 55,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 60,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 64,
                "startBeat": 0,
                "lengthBeats": 8
              },
              {
                "pitch": 67,
                "startBeat": 0,
                "lengthBeats": 8
              }
            ]
          }
        }
      ]
    },
    {
      "name": "modulated-vol05",
      "axis": "THE MEASUREMENT \u2014 volume 0.5 plus a 4 Hz square LFO routed to .volume at depth -0.6, exactly the mod-gater configuration that produced no effect",
      "commands": [
        {
          "command": "track.add",
          "params": {
            "name": "Pad",
            "kind": "instrument"
          },
          "as": "pad"
        },
        {
          "command": "track.setInstrument",
          "params": {
            "trackId": "$pad",
            "kind": "polySynth",
            "waveform": "saw",
            "attack": 0.02,
            "decay": 0.3,
            "sustain": 0.9,
            "release": 0.4,
            "cutoffHz": 2200,
            "resonance": 0.12,
            "gain": 0.75
          }
        },
        {
          "command": "track.setVolume",
          "params": {
            "trackId": "$pad",
            "volume": 0.5
          }
        },
        {
          "command": "mod.addSource",
          "params": {
            "trackId": "$pad",
            "kind": "lfo",
            "name": "Gate",
            "waveform": "square",
            "rateHz": 4,
            "pulseWidth": 0.5,
            "edgeMs": 3,
            "bipolar": false
