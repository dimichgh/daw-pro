            { "pitch": 72, "startBeat": 5, "lengthBeats": 0.9 },
            { "pitch": 67, "startBeat": 6, "lengthBeats": 0.9 },
            { "pitch": 60, "startBeat": 7, "lengthBeats": 1.8 }
          ]
        } }
      ]
    },
    {
      "name": "extreme",
      "axis": "8 voices, unisonDetuneCents = 35 — deliberately past tasteful, to hear where it stops being 'wide' and starts being 'out of tune'",
      "commands": [
        { "command": "track.add", "params": { "name": "Lead", "kind": "instrument" }, "as": "lead" },
