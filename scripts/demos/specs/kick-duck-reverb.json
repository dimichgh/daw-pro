{
  "set": "kick-duck-reverb",
  "description": "Tests whether today's primitives already produce sidechain-ducked ('pumping') reverb with ZERO new code: a kick + a sustained pad feeding a reverb bus, with a compressor AFTER the reverb on that bus, keyed off the kick. Axis across variants: the sidechain key and the ducking compressor's release/depth. Variant 'control' is the positive control \u2014 same compressor, no key \u2014 everything else must be measured against it, not assumed.",
  "measurement": {
    "type": "periodicDucking",
    "periodSeconds": 0.5,
    "cycleStartSeconds": 0.0,
    "cycleCount": 32,
    "skipEdgeCycles": 2,
    "_comment": "Measured on the ISOLATED reverb-bus stem (measureStem below), not the full mixdown -- the kick's own direct sound is identical across every variant and would otherwise swamp a trough window taken while the kick is audible. The bus stem contains only the pad's wet send through reverb+compressor, with the REAL live sidechain-affected output (render.stems preserves the sidechain graph).",
    "troughOffsetSeconds": 0.02,
    "troughWindowSeconds": 0.15,
    "peakOffsetSeconds": 0.35,
    "peakWindowSeconds": 0.13,
    "compareToRole": "control"
  },
  "variants": [
    {
      "name": "control",
      "role": "control",
      "axis": "sidechain OFF \u2014 the positive control: the reverb-bus compressor is present with the SAME settings as 'duck-fast', just never keyed, so it reacts only to its own (roughly constant) bus level, not the kick",
      "commands": [
        {
          "command": "track.add",
          "params": {
            "name": "Kick",
            "kind": "instrument"
          },
          "as": "kick"
        },
        {
