# DAW Pro singing engine pins (item p2-sing-b; design docs/design/2026-09-27-p2-sing-integration.md §2.5).
# install.sh READS this file line by line (it never sources or evaluates it); server.py reads it through
# singlib/pins.py. Format: KEY=value or KEY="value with spaces"; no $, backquote, backslash or quote in a value.
# Evidence tags as in the design: [M] measured on this Mac, [R] read from a published source, [A] chosen.
# Tests point SING_PINS_FILE at a fixture copy of this file; the app never sets it.

# Bumped whenever these scripts change what an install produces. install.json records it.
SCRIPTS_VERSION=1

# uv, the spike's version (logs/preflight-s9.txt:49) [M]. The sha256 is the release's published checksum [R]:
# https://github.com/astral-sh/uv/releases/download/0.11.19/uv-aarch64-apple-darwin.tar.gz.sha256 (read 2026-09-27)
UV_VERSION=0.11.19
UV_ASSET=uv-aarch64-apple-darwin.tar.gz
UV_URL=https://github.com/astral-sh/uv/releases/download/0.11.19/uv-aarch64-apple-darwin.tar.gz
UV_SHA256=d8f59c38e8c4168ee468d423cd63184be12fa6995a4283d41ee1a14d003c9453

# CPython, the spike's (venv-alt/pyvenv.cfg) [M]. uv downloads it and checks it against uv's own pinned hash.
PYTHON_VERSION=3.10.20

# The lock: the spike's logs/freeze-alt.txt VERBATIM (83 pins, sha256 1e00efc3...) [M]. Installed with --no-deps, then
# `uv pip check` (it passes on the spike's venv-alt: 83 packages compatible) [M].
LOCK_FILE=requirements.lock
VERIFY_IMPORTS="torch torchaudio torchcodec numpy soundfile soxr g2p_en nltk huggingface_hub omegaconf librosa"

# Upstream at the spike's pin [M]; verified with git rev-parse HEAD.
UPSTREAM_URL=https://github.com/Soul-AILab/SoulX-Singer
UPSTREAM_COMMIT=81aeb3ae772c70093c3de74dc23c92d983801ae4

# Weights: two files at a pinned revision [M]. model.pt is also a SAFETY pin: upstream loads it with
# torch.load(weights_only=False), which is an unpickle.
WEIGHTS_REPO=Soul-AILab/SoulX-Singer
WEIGHTS_REVISION=40493ad90286056c7a9095035164434a79daa8c9
MODEL_FILE=model.pt
MODEL_BYTES=2818092278
MODEL_SHA256=447eaf41f91a6b6659d55e9ec3c9b809221724fb8592aebaec35a23751a5b500
CONFIG_FILE=config.yaml
CONFIG_BYTES=579
CONFIG_SHA256=d164c978dde6f57e1075bc21ef5f9b7b27895267f35b735cebe863418492be38

# NLTK data. sha256 of the zips the spike's working runtime used (cache/nltk) [M]. nltk_data is not versioned, so a
# changed zip upstream fails the install loudly instead of shipping untested data.
NLTK_PACKAGES="cmudict averaged_perceptron_tagger averaged_perceptron_tagger_eng"
NLTK_ZIP_cmudict=corpora/cmudict.zip
NLTK_SHA256_cmudict=d07cca47fd72ad32ea9d8ad1219f85301eeaf4568f8b6b73747506a71fb5afd6
NLTK_ZIP_averaged_perceptron_tagger=taggers/averaged_perceptron_tagger.zip
NLTK_SHA256_averaged_perceptron_tagger=e1f13cf2532daadfd6f3bc481a49859f0b8ea6432ccdcd83e6a49a5f19008de9
NLTK_ZIP_averaged_perceptron_tagger_eng=taggers/averaged_perceptron_tagger_eng.zip
NLTK_SHA256_averaged_perceptron_tagger_eng=6025f530624335c67d6547d44757b357b4e79bae030a0383e9887a92c1718f0b

# The built-in voice "builtin-1" = the user's pick v1: upstream's zh_prompt cut to its metadata window [M].
# The spike's fixtures/zh_prompt_cut.wav is 48 kHz float32 (the mp3's own rate), written by ffmpeg 8.1.1
# (Lavf62.12.101 in its LIST chunk). Rebuilt with INPUT seeking (-ss/-to before -i); output seeking gives other bytes.
BUILTIN_VOICE_ID=builtin-1
BUILTIN_SOURCE_AUDIO=example/audio/zh_prompt.mp3
BUILTIN_SOURCE_META=example/audio/zh_prompt.json
BUILTIN_CUT_START=0.32
BUILTIN_CUT_END=10.687
BUILTIN_WAV_SHA256=a65d6d51984999484f6bbd3ee3b1ea896c95aed5e2361572bc4f7b29b071912f
BUILTIN_META_SHA256=614d8057b01a3f48862e1324b8181df246bc8c3399c7cb9520c4770fefd86efd
# Diagnostic only, never a pass: the sha256 of the WAV's data chunk (497616 float32 samples) [M]. When the file sha
# fails, install.sh reports whether the AUDIO differs or only the header (e.g. a newer ffmpeg's Lavf string).
BUILTIN_PCM_SHA256=539edd796bfec3c9b3a0ee54f8744b6581024f28f6ffb5c1dc3da8e1efaf8761

# FFmpeg is required and the design does not say so [M]: the built-in voice cut runs the ffmpeg CLI, and at run time
# torchaudio 2.11 reads every prompt through torchcodec, whose dylibs carry LC_RPATH /opt/homebrew/opt/ffmpeg/lib.
FFMPEG_LIB_DIR=/opt/homebrew/opt/ffmpeg/lib

# Preflight [A]: about 5 GB installed plus staging plus margin; the measured install size replaces this.
MIN_MACOS=14
MIN_FREE_KB=12582912
